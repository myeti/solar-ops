# ──────────────────────────────────────────────────────────────────────
# SolarOps — system configuration
#
# Copy to .env (deploy/install.sh does it for you). Everything here is
# about how SolarOps talks to the operating system, so it is only
# editable from the server shell, never from the web UI.
# ──────────────────────────────────────────────────────────────────────

NODE_ENV=production

# HTTP binding. Keep 127.0.0.1 and expose SolarOps through nginx + HTTPS.
SOLAROPS_HOST=127.0.0.1
SOLAROPS_PORT=4100

# Express "trust proxy" (SolarOps sits behind nginx on the same host).
SOLAROPS_TRUST_PROXY=loopback

# Session cookie "Secure" flag: auto (when the request is HTTPS), true or false.
SOLAROPS_COOKIE_SECURE=auto

# Session lifetime.
SOLAROPS_SESSION_IDLE_HOURS=24
SOLAROPS_SESSION_MAX_DAYS=7

# SolarOps state: SQLite database, master key, git askpass helper.
# BACK THIS FOLDER UP: without master.key, stored secrets cannot be decrypted.
SOLAROPS_DATA_DIR=./data

# Projects base folder (must match the nginx include written by deploy/install.sh).
# Can still be changed in Settings while no project lives in it.
SOLAROPS_BASE_FOLDER=/var/www

# Optional: store SolarOps's own data in PostgreSQL instead of SQLite.
# SOLAROPS_DB_URL=postgres://solarops:secret@127.0.0.1:5432/solarops

# Optional: provide the 32-byte master key (hex or base64) instead of data/master.key.
# SOLAROPS_MASTER_KEY=

# Initial PostgreSQL admin connection used to create project databases
# (written by deploy/install.sh; the connection saved in the UI takes over).
SOLAROPS_PG_HOST=127.0.0.1
SOLAROPS_PG_PORT=5432
SOLAROPS_PG_USER=solarops_admin
SOLAROPS_PG_PASSWORD=

# Commands (split on spaces, no shell involved).
SOLAROPS_GIT_BIN=git
SOLAROPS_NPM_BIN=npm
SOLAROPS_PM2_BIN=pm2
SOLAROPS_CERTBOT_BIN=certbot
SOLAROPS_PG_DUMP_BIN=pg_dump
SOLAROPS_PG_RESTORE_BIN=pg_restore
SOLAROPS_NGINX_TEST_CMD=sudo -n /usr/sbin/nginx -t
SOLAROPS_NGINX_RELOAD_CMD=sudo -n /usr/bin/systemctl reload nginx

# Generated nginx server blocks also listen on IPv6.
SOLAROPS_NGINX_IPV6=true

# Maximum duration of an install / build step, in minutes.
SOLAROPS_TASK_TIMEOUT_MINUTES=20

# After a (re)start, how long an application has to answer on / (liveness
# probe on 127.0.0.1:<port>). A deployment fails when it does not. Default of
# the projects: each can set its own startup time (project Settings tab).
SOLAROPS_LIVENESS_TIMEOUT_SECONDS=30

# How often the alert rules are checked (System › Alerts). Rules needing
# several checks in a row (CPU, memory, projects) count in checks.
SOLAROPS_ALERT_CHECK_SECONDS=60

# debug | info | warn | error
SOLAROPS_LOG_LEVEL=info
