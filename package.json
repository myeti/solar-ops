{
  "name": "solarops",
  "version": "0.2.1",
  "description": "Mission control for your VPS: create, deploy and manage many projects on a single server (pm2, nginx, certbot, PostgreSQL).",
  "author": "Magalon",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "solarops": "bin/solarops.js"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=server server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "serve": "node server/index.js",
    "setup": "bash deploy/install.sh",
    "start": "bash deploy/service.sh start",
    "stop": "bash deploy/service.sh stop",
    "restart": "bash deploy/service.sh restart",
    "update": "bash deploy/update.sh",
    "rollback": "bash deploy/update.sh --rollback",
    "cli": "node bin/solarops.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "feather-icons": "^4.29.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.6",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "core-js": false
  }
}
